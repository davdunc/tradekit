# Tradekit Environment Variables
# ==============================
#
# Copy this file to `.env` (for standalone use) OR add these variables to
# your shared LifeOS `.env` at ~/.claude/.env when running inside LifeOS.
#
# Load order (highest precedence last):
#   1. ./.env                 — project-local (standalone)
#   2. ~/.claude/.env         — LifeOS's shared .env (also the Claude Code default)
#   3. $PAI_DIR/.env          — deprecated (PAI is now LifeOS); only while PAI_DIR is set
#   4. System environment variables
#
# SECURITY RULES:
#   1. NEVER commit .env files to git (.gitignore already protects you)
#   2. NEVER share API keys in issues, chats, or screenshots
#   3. Rotate keys if you suspect exposure
#
# Run `tradekit init` after install to populate this interactively.

# ============================================================
# DATA SOURCES
# ============================================================

# Finviz Elite — https://finviz.com/elite.ashx
# Used by: pre-market scanner, news feed
# Free tier: works for basic screening; Elite unlocks news + export
FINVIZ_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# Used by: fundamentals, historical fallback when Yahoo is rate-limited
ALPHAVANTAGE_API_KEY=

# Massive.com (formerly Polygon) — https://massive.com
# One key for Massive's REST API. Used by: gex (needs an options plan with chain
# snapshots), regime, the blotter's same-day fallback, --source=massive.
# POLYGON_API_KEY is a deprecated alias: still read, with a warning. Rename it to this.
MASSIVE_API_KEY=
# Optional: the REST base URL (default https://api.massive.com).
# MASSIVE_API_BASE=

# DAS Trader CMD API — `tradekit depth das-probe` (and the DAS depth source, #9). Set these on
# the DAS machine itself: DAS binds loopback, so DAS_HOST is 127.0.0.1 there. DAS_PORT is that
# node's own (DAS Setup > API), with no default. tradekit logs in in WATCH mode only, which
# can't place orders, and refuses to send any order command.
DAS_HOST=
DAS_PORT=
DAS_USER=
DAS_PASSWORD=
DAS_ACCOUNT=

# IB Gateway / TWS — `tradekit depth record` (the fallback in --source auto, or --source ibkr)
# Gateway: 4002 paper, 4001 live. TWS: 7497 paper, 7496 live. No default: set both, or
# the IBKR source is reported as unconfigured rather than guessing a port.
IBKR_HOST=
IBKR_PORT=
IBKR_CLIENT_ID=17
# Concurrent depth requests the account accepts. 4 was measured on a paper account (TWS's 309
# text says "Max number (3)" yet accepts a fourth); Quote Booster raises it.
IBKR_DEPTH_LIMIT=4

# ============================================================
# BACKTEST STORAGE (S3-compatible flat files)
# ============================================================

# Required only if --source=backtest
# Massive S3 flat-file keys. MASSIVE_S3_ACCESS_KEY / MASSIVE_S3_SECRET_KEY are deprecated aliases.
BACKTEST_ACCESS_KEY=
BACKTEST_SECRET_KEY=
BACKTEST_BUCKET=flatfiles
BACKTEST_ENDPOINT=https://files.massive.com

# ============================================================
# ALERTS (optional)
# ============================================================

# Slack incoming webhook — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# SMTP (for email alerts)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Minimum score (0-100) to trigger an alert
ALERT_SCORE_THRESHOLD=75

# ============================================================
# TUNING (optional — defaults are usually fine)
# ============================================================

# Cache TTL in minutes
YAHOO_CACHE_TTL_MINUTES=5
FINVIZ_CACHE_TTL_MINUTES=10

# Screener thresholds
MIN_GAP_PCT=2.0
MIN_PREMARKET_VOLUME=200000
MIN_PRICE=2.0
MAX_PRICE=200.0
