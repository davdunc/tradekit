#!/bin/sh
# Run the WSL-installed tradekit from Git Bash on Windows (what Claude Code's Bash tool uses).
# A login shell is used so ~/.local/bin and PAI_DIR from your WSL profile apply.
# Set TRADEKIT_WSL_DISTRO to pick a distro; otherwise the WSL default is used.
if [ -n "$TRADEKIT_WSL_DISTRO" ]; then
    exec wsl.exe -d "$TRADEKIT_WSL_DISTRO" --exec bash -lc 'exec tradekit "$@"' tradekit "$@"
fi
exec wsl.exe --exec bash -lc 'exec tradekit "$@"' tradekit "$@"
